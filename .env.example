NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
HTTP_BODY_LIMIT_BYTES=102400
THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000

# Supabase Connect -> Session pooler (port 5432). Never commit real credentials.
# Fill both URLs for development. The public CA is in prisma/certs/supabase-ca.crt.
# DATABASE_URL: application; append sslmode=verify-full&sslrootcert=prisma/certs/supabase-ca.crt
# DIRECT_URL: migrations; append sslmode=require&sslaccept=strict&sslcert=prisma/certs/supabase-ca.crt
DATABASE_URL=
DIRECT_URL=
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000

# Project API URL and Auth endpoints for the AuthModule implementation.
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

REDIS_URL=

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
# Optional provider settings; no provider calls are implemented by the starter.
# Keep model IDs environment-configured and verify capabilities before use.
AI_PROVIDER=
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_PROMPT_VERSION=
EMBEDDING_DIMENSION=768

RAG_TOP_K=5
INVESTIGATION_CONCURRENCY=2
# MVP must stay true; real financial/provider actions are outside scope.
ACTION_SIMULATION=true
SUPPORT_FORM_TOKEN_PEPPER=

JWT_SECRET=