NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
HTTP_BODY_LIMIT_BYTES=102400
THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000

# Supabase Connect -> Session pooler (port 5432). Never commit real credentials.
# Fill both URLs for development. The public CA is in prisma/certs/supabase-ca.crt.
# DATABASE_URL: application; append sslmode=verify-full&sslrootcert=prisma/certs/supabase-ca.crt
# DIRECT_URL: migrations; append sslmode=require&sslaccept=strict&sslcert=prisma/certs/supabase-ca.crt
DATABASE_URL=
DIRECT_URL=
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000

# Auth: HTTPS project URL enables real asymmetric JWT + current-session verification.
# Issuer/JWKS default from SUPABASE_URL; legacy HS256 is unsupported.
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

REDIS_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# AI_MODEL takes precedence over GEMINI_MODEL. No provider fallback or fake success.
# Verify these dated model defaults against your key with pnpm ai:probe.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_PROMPT_VERSION=handled-core-v1
EMBEDDING_DIMENSION=768

RAG_TOP_K=5
INVESTIGATION_CONCURRENCY=2
# MVP must stay true; real financial/provider actions are outside scope.
ACTION_SIMULATION=true
SUPPORT_FORM_TOKEN_PEPPER=
# Optional private BFF/API shared signing secret (at least 32 random characters).
# When set, public intake requires signed client-IP headers; never expose it to browsers.
SUPPORT_PROXY_SECRET=

# Public intake is disabled unless both values are configured.
# Generate a private random pepper of at least 32 characters. Never use the form token as login.
PUBLIC_INTAKE_ORIGINS=

# Optional explicit scoped fixture setup; see docs/backend-foundation-setup.md.
# SEED_MODE=scoped
# SEED_ALLOW_SCOPED=true
# SEED_WORKSPACE_ID=
# SEED_PIXEL_WORKSPACE_ID=
# SEED_ADMIN_USER_ID=
# SEED_AGENT_USER_ID=
# SEED_VIEWER_USER_ID=
# SEED_PIXEL_ADMIN_USER_ID=
