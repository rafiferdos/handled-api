model InvestigationRun {
  id                      String              @id @default(uuid()) @db.Uuid
  workspaceId             String              @db.Uuid
  ticketId                String              @db.Uuid
  parentRunId             String?             @db.Uuid
  status                  InvestigationStatus @default(QUEUED)
  provider                String              @db.VarChar(100)
  model                   String              @db.VarChar(100)
  promptVersion           String              @db.VarChar(100)
  triggeredByUserId       String              @db.Uuid
  triggeredByMembershipId String              @db.Uuid
  triggeredBySessionId    String              @db.Uuid
  requestId               String              @db.VarChar(128)
  classification          Json?
  startedAt               DateTime?           @db.Timestamptz(3)
  finishedAt              DateTime?           @db.Timestamptz(3)
  failureCode             String?             @db.VarChar(64)
  version                 Int                 @default(1)
  createdAt               DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(3)
  workspace               Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  ticket                  Ticket              @relation(fields: [workspaceId, ticketId], references: [workspaceId, id], onDelete: Restrict)
  triggeredBy             Profile             @relation(fields: [triggeredByUserId], references: [id], onDelete: Restrict)
  membership              Membership          @relation(fields: [workspaceId, triggeredByMembershipId, triggeredByUserId], references: [workspaceId, id, userId], onDelete: Restrict)
  parent                  InvestigationRun?   @relation("RunRetry", fields: [workspaceId, ticketId, parentRunId], references: [workspaceId, ticketId, id], onDelete: Restrict, onUpdate: NoAction)
  retries                 InvestigationRun[]  @relation("RunRetry")
  steps                   InvestigationStep[]
  proposals               Proposal[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, ticketId, id])
  @@index([workspaceId, ticketId, createdAt(sort: Desc), id])
  @@index([workspaceId, ticketId, parentRunId])
  @@index([triggeredByUserId])
  @@index([workspaceId, triggeredByMembershipId, triggeredByUserId])
  @@schema("handled")
}

model InvestigationStep {
  id              String                  @id @default(uuid()) @db.Uuid
  workspaceId     String                  @db.Uuid
  investigationId String                  @db.Uuid
  sequence        Int
  type            InvestigationStepType
  label           String                  @db.VarChar(256)
  status          InvestigationStepStatus
  toolName        String?                 @db.VarChar(100)
  sourceRefs      Json                    @default("[]")
  durationMs      Int?
  errorCode       String?                 @db.VarChar(64)
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(3)
  workspace       Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  investigation   InvestigationRun        @relation(fields: [workspaceId, investigationId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, investigationId, sequence])
  @@schema("handled")
}

model Proposal {
  id                    String            @id @default(uuid()) @db.Uuid
  workspaceId           String            @db.Uuid
  ticketId              String            @db.Uuid
  investigationId       String            @db.Uuid
  version               Int
  status                ProposalStatus    @default(DRAFT)
  category              TicketCategory
  confidence            Confidence
  summary               String            @db.Text
  recommendationType    ActionType?
  recommendationPayload Json?
  replyDraft            String            @db.Text
  missingFacts          Json              @default("[]")
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)
  workspace             Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  ticket                Ticket            @relation(fields: [workspaceId, ticketId], references: [workspaceId, id], onDelete: Restrict)
  investigation         InvestigationRun  @relation(fields: [workspaceId, ticketId, investigationId], references: [workspaceId, ticketId, id], onDelete: Restrict)
  sources               ProposalSource[]
  decision              ProposalDecision?

  @@unique([workspaceId, id])
  @@unique([workspaceId, id, version])
  @@unique([workspaceId, investigationId, version])
  @@index([workspaceId, ticketId, createdAt(sort: Desc), id])
  @@index([workspaceId, ticketId, investigationId])
  @@schema("handled")
}

model ProposalSource {
  id              String     @id @default(uuid()) @db.Uuid
  workspaceId     String     @db.Uuid
  proposalId      String     @db.Uuid
  sourceType      SourceType
  sourceRefId     String     @db.VarChar(256)
  title           String     @db.VarChar(256)
  excerpt         String     @db.Text
  contentHash     String     @db.Char(64)
  observedAt      DateTime   @db.Timestamptz(3)
  documentId      String?    @db.Uuid
  documentVersion Int?
  chunkId         String?    @db.Uuid
  score           Float?
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  proposal        Proposal   @relation(fields: [workspaceId, proposalId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, proposalId, sourceRefId])
  @@schema("handled")
}

model ProposalDecision {
  id                String               @id @default(uuid()) @db.Uuid
  workspaceId       String               @db.Uuid
  proposalId        String               @db.Uuid
  proposalVersion   Int
  kind              ProposalDecisionKind
  actorUserId       String               @db.Uuid
  actorMembershipId String               @db.Uuid
  actorSessionId    String               @db.Uuid
  reason            String?              @db.Text
  requestId         String               @db.VarChar(128)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  proposal          Proposal             @relation(fields: [workspaceId, proposalId, proposalVersion], references: [workspaceId, id, version], onDelete: Restrict)
  actor             Profile              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  membership        Membership           @relation(fields: [workspaceId, actorMembershipId, actorUserId], references: [workspaceId, id, userId], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, proposalId, proposalVersion])
  @@index([actorUserId])
  @@index([workspaceId, actorMembershipId, actorUserId])
  @@schema("handled")
}
