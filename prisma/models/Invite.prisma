// ERD: Invite. SQL-only constraints below require a reviewed migration.

model Invite {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String        @db.Uuid
  email            String        @db.VarChar(255)
  role             member_role   @default(AGENT)
  /// Store only the token hash, never the raw invitation secret.
  tokenHash        String        @unique @db.VarChar(255)
  status           invite_status @default(PENDING)
  expiresAt        DateTime      @db.Timestamptz(6)
  acceptedAt       DateTime?     @db.Timestamptz(6)
  acceptedByUserId String?       @db.Uuid
  revokedAt        DateTime?     @db.Timestamptz(6)
  createdByUserId  String        @db.Uuid
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  acceptedBy Profile?   @relation("InviteAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator    Membership @relation("InviteCreator", fields: [workspaceId, createdByUserId], references: [workspaceId, userId], onDelete: Restrict, onUpdate: Restrict)

  // SQL CHECK constraints: prisma/sql/profile-workspace-constraints.sql

  @@unique([workspaceId, id])
  @@index([workspaceId, email, status], map: "idx_invite_email_status")
}

enum invite_status {
  EXPIRED
  PENDING
  ACCEPTED
  REVOKED
}
