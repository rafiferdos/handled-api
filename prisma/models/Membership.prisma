// ERD: Membership. SQL-only constraints below require a reviewed migration.

model Membership {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String            @db.Uuid
  userId          String            @db.Uuid
  role            member_role       @default(AGENT)
  status          membership_status @default(ACTIVE)
  invitedByUserId String?           @db.Uuid
  joinedAt        DateTime?         @db.Timestamptz(6)
  disabledAt      DateTime?         @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @db.Timestamptz(6)

  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user           Profile      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inviter        Membership?  @relation("MembershipInviter", fields: [workspaceId, invitedByUserId], references: [workspaceId, userId], onDelete: Restrict, onUpdate: Restrict)
  invitedMembers Membership[] @relation("MembershipInviter")
  createdInvites Invite[]     @relation("InviteCreator")
  // SQL CHECK constraints: prisma/sql/profile-workspace-constraints.sql

  @@unique([workspaceId, userId], map: "uq_membership_workspace_user")
  @@unique([workspaceId, id])
  @@unique([workspaceId, id, userId])
  @@index([userId, status], map: "idx_membership_user_status")
}

enum member_role {
  ADMIN
  AGENT
  VIEWER
}

enum membership_status {
  INVITED
  ACTIVE
  DISABLED
}
