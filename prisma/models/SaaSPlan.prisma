// ERD: SaaSPlan. SQL-only constraints below require a reviewed migration.

model SaaSPlan {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @db.VarChar(80)
  version Int @default(1)
  name String @db.VarChar(160)
  status FuturePlanStatus @default(DRAFT)
  seatLimit Int
  monthlyAiInvestigationLimit Int
  entitlements Json @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)

  subscriptions WorkspaceSubscription[]
  @@unique([code, version])
  // check_1: CHECK ("version" >= 1 AND "seatLimit" >= 1 AND "monthlyAiInvestigationLimit" >= 0)
  // check_2: CHECK (jsonb_typeof("entitlements") = 'object')
  // check_3: CHECK ("updatedAt" >= "createdAt")
}

enum FuturePlanStatus {
  DRAFT
  ACTIVE
  RETIRED
}
