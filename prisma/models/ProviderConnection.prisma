// ERD: ProviderConnection. SQL-only constraints below require a reviewed migration.

model ProviderConnection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @db.Uuid
  provider String @db.VarChar(80)
  scopes Json @default("[]") @db.JsonB
  credentialRef String? @db.Text
  status FutureConnectionStatus @default(PENDING)
  installedByUserId String @db.Uuid
  expiresAt DateTime? @db.Timestamptz(6)
  lastVerifiedAt DateTime? @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  lastErrorCode String? @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  installer Membership @relation(fields: [workspaceId, installedByUserId], references: [workspaceId, userId], onDelete: Restrict, onUpdate: Restrict)
  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  // check_1: CHECK (jsonb_typeof("scopes") = 'array')
  // check_2: CHECK ("status" <> 'ACTIVE' OR ("credentialRef" IS NOT NULL AND char_length("credentialRef") > 0))
  // check_3: CHECK ("updatedAt" >= "createdAt")
}

enum FutureConnectionStatus {
  PENDING
  ACTIVE
  DEGRADED
  EXPIRED
  REVOKED
  FAILED
}
